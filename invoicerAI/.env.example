# InvoicerAI Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.

# ── OCR ──────────────────────────────────────────────────────────────────────
# OCR.space API key (free tier available at https://ocr.space/ocrapi)
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
OCR_LANGUAGE=eng

# ── LLM (Ollama / local Llama 3) ─────────────────────────────────────────────
# Ollama must be running locally: https://ollama.com
# Pull the model first: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/receipt_db

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
# Maximum total LLM extraction attempts (initial + retries/repairs)
MAX_EXTRACTION_ATTEMPTS=3

# Monetary tolerance for business-rule cross-checks (e.g. rounding differences)
MONETARY_TOLERANCE=0.05

# OCR API request timeout in seconds
OCR_TIMEOUT=30

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
